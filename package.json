{
  "name": "showup-app",
  "version": "1.0.0",
  "description": "ShowUp - Workout Tracker & Social Squads",
  "main": "index.html",
  "scripts": {
    "build": "python3 scripts/build_web.py",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "test": "python3 scratch/build_and_run_smoke_test.py"
  },
  "keywords": [
    "fitness",
    "workout-tracker",
    "pwa",
    "capacitor"
  ],
  "author": "ShowUp",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.0"
  }
}
